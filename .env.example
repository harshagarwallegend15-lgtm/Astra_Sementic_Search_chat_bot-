# ASTRA INTEL configuration
# Copy to .env and edit. Never commit .env -- it may contain API keys.

# --- Language model ---------------------------------------------------------
# LLM_PROVIDER: ollama | openai
#   "openai" works with any OpenAI-compatible endpoint (OpenAI, Together, Groq,
#   LM Studio, vLLM, Ollama's compatibility layer, ...).
LLM_PROVIDER=ollama

# Local model. Run `ollama pull llama3.2:3b` first.
# Alternatives: llama3.1:8b (better quality, slower on CPU), qwen2.5:7b.
LLM_MODEL=llama3.2:3b

# Only needed for hosted providers. Leave blank for Ollama.
LLM_API_KEY=

# Override the endpoint. Blank means "infer from the provider".
# Examples:
#   http://localhost:11434            (Ollama)
#   https://api.openai.com/v1
#   http://localhost:1234/v1          (LM Studio)
#   http://localhost:8000/v1          (vLLM)
LLM_BASE_URL=

# 0.0 keeps answers deterministic, which matters for citation accuracy.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=900
LLM_TIMEOUT=180
# Context window. On CPU, a smaller window is meaningfully faster.
LLM_NUM_CTX=8192

# --- Embeddings -------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# auto    = try MiniLM, fall back to a local hashing embedder if it cannot load
# semantic= require MiniLM, fail loudly if it cannot load
# hashing = always use the offline hashing embedder (fast, lower quality)
#          This is what the test suite uses, so `pytest` needs no model download.
EMBEDDING_BACKEND=auto
EMBEDDING_BATCH_SIZE=64

# --- Chunking ---------------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
MIN_CHUNK_CHARS=60

# --- Retrieval --------------------------------------------------------------
TOP_K=8
CANDIDATE_K=24
# hybrid | dense | lexical
RETRIEVAL_MODE=hybrid
# Fused evidence score below this counts as "no evidence".
MIN_RETRIEVAL_SCORE=0.30
# Semantic floor. all-MiniLM-L6-v2 compresses similarity (unrelated pairs sit
# around 0.1-0.3, strong matches 0.6-0.8), so keep this low. This is a coarse
# relevance filter, not a truth oracle.
#
# Measured on the starter corpus: passages from the *right* document average
# 0.25, but a long tail of them falls below 0.10. A floor of 0.25 therefore
# discards evidence the model needs. Lowering it to 0.10 is neutral on the
# 10-question benchmark and never regressed it.
#
# `BAAI/bge-small-en-v1.5` was evaluated and rejected: it pushes every score
# into a narrow 0.5-0.8 band and separated on-topic from off-topic chunks about
# half as well as MiniLM (mean gap 0.016 vs 0.041). See scripts/calibrate.py.
MIN_DENSE_SIMILARITY=0.10
# Max passages from one document. 0 disables the cap, which is the default:
# capping caused false refusals on "name one specific programme" questions.
MAX_CHUNKS_PER_DOCUMENT=0
# Reserve a context slot for each competitive rival document. A rival earns a
# slot when its best passage scores at least this fraction of the overall best.
# Additive, so it adds cross-document evidence without evicting top passages.
# Set 0 to disable and rank purely by score.
DOCUMENT_DIVERSITY_RATIO=0.45
EXCLUDE_REFERENCE_SECTIONS=true

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=50
MIN_CHARS_PER_PAGE=40
MIN_DOCUMENT_CHARS=200

# --- Summaries --------------------------------------------------------------
SUMMARY_MAP_CHUNKS=10
SUMMARY_REDUCE_CHUNKS=8

# --- Behaviour --------------------------------------------------------------
# When true, an answer with no resolvable citation is treated as ungrounded.
STRICT_CITATIONS=false
LOG_LEVEL=INFO

# --- Paths (relative paths resolve inside the project) ----------------------
# VECTORSTORE_DIR=data/vectorstore
# UPLOADS_DIR=data/uploads
